---
import { readCategoriesEnvelope } from "../lib/read-categories";

Astro.response.headers.set("cache-control", "no-store");

const { entries, readCount, lastReadAt } = await readCategoriesEnvelope();
const summary = entries.map((entry) => {
  const image = entry.data.image;

  return {
    id: entry.id,
    imageType: image === null ? "null" : typeof image,
    hasSrc: !!image && typeof image === "object" && "src" in image,
  };
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Astro Missing Image Recovery Repro</title>
  </head>
  <body>
    <main>
      <h1>Astro Missing Image Recovery Repro</h1>
      <p>
        Start <code>astro dev</code>, then inspect <a href="/api/probe">/api/probe</a>
        and <a href="/api/validate">/api/validate</a>.
      </p>
      <p>
        Run <code>node scripts/repro-missing-image-recovery.mjs</code> in another terminal
        to simulate a broken image path that is later restored.
      </p>
      <p>Shared reader count: <code>{readCount}</code></p>
      <p>Last shared read: <code>{lastReadAt}</code></p>
      <pre>{JSON.stringify(summary, null, 2)}</pre>
    </main>
  </body>
</html>
